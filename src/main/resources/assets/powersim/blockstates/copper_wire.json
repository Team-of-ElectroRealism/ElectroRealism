{
  "multipart": [
    { "apply": { "model": "powersim:block/copper_wire_dot" },
      "when": { "north": false, "east": false, "south": false, "west": false, "down_north": false, "down_south": false, "down_east": false, "down_west": false, "up_north": false, "up_south": false, "up_east": false, "up_west": false }
    },


    { "apply": { "model": "powersim:block/copper_wire_convertical", "x": 90, "y": 180 },
      "when": { "up_north": true, "south": true }
    },
    { "apply": { "model": "powersim:block/copper_wire_convertical", "x": 90, "y": 0 },
      "when": { "up_south": true, "north": true }
    },
    { "apply": { "model": "powersim:block/copper_wire_convertical", "x": 90, "y": 270 },
      "when": { "up_east": true, "west": true }
    },
    { "apply": { "model": "powersim:block/copper_wire_convertical", "x": 90, "y": 90 },
      "when": { "up_west": true, "east": true }
    },


    { "apply": { "model": "powersim:block/copper_wire_vertical", "x": 0 },
      "when": { "up_north": true, "south": false }
    },
    { "apply": { "model": "powersim:block/copper_wire_vertical", "x": 180, "y": 0 },
      "when": { "up_south": true, "north": false }
    },
    { "apply": { "model": "powersim:block/copper_wire_vertical", "x": 180, "y": 270 },
      "when": { "up_east": true, "west": false }
    },
    { "apply": { "model": "powersim:block/copper_wire_vertical", "x": 180, "y": 90 },
      "when": { "up_west": true, "east": false }
    },

    { "apply": { "model": "powersim:block/copper_wire_vertical", "x": 90 },
      "when": { "down_north": true, "north": false }
    },
    { "apply": { "model": "powersim:block/copper_wire_vertical", "x": 90, "y": 180 },
      "when": { "down_south": true, "south": false }
    },
    { "apply": { "model": "powersim:block/copper_wire_vertical", "x": 90, "y": 270 },
      "when": { "down_east": true, "east": false }
    },
    { "apply": { "model": "powersim:block/copper_wire_vertical", "x": 90, "y": 90 },
      "when": { "down_west": true, "west": false }
    },


    { "apply": { "model": "powersim:block/copper_wire_line" },
      "when": { "north": true, "south": true, "east": false, "west": false, "up_north": false, "down_north": false, "up_south": false, "down_south": false }
    },
    { "apply": { "model": "powersim:block/copper_wire_line", "y": 90 },
      "when": { "east": true, "west": true, "north": false, "south": false, "up_east": false, "down_east": false, "up_west": false, "down_west": false }
    },

    { "apply": { "model": "powersim:block/copper_wire_corner", "y": 90 },
      "when": { "north": true, "east": true, "up_north": false, "down_north": false, "up_east": false, "down_east": false }
    },
    { "apply": { "model": "powersim:block/copper_wire_corner" },
      "when": { "north": true, "west": true, "up_north": false, "down_north": false, "up_west": false, "down_west": false }
    },
    { "apply": { "model": "powersim:block/copper_wire_corner", "y": 270 },
      "when": { "south": true, "west": true, "up_south": false, "down_south": false, "up_west": false, "down_west": false }
    },
    { "apply": { "model": "powersim:block/copper_wire_corner", "y": 180 },
      "when": { "south": true, "east": true, "up_south": false, "down_south": false, "up_east": false, "down_east": false }
    },

    { "apply": { "model": "powersim:block/copper_wire_t", "y": 0 },
      "when": { "north": true, "east": true, "west": true, "south": false, "up_north": false, "down_north": false }
    },
    { "apply": { "model": "powersim:block/copper_wire_t", "y": 180 },
      "when": { "north": false, "east": true, "south": true, "west": true, "up_south": false, "down_south": false }
    },
    { "apply": { "model": "powersim:block/copper_wire_t", "y": 270 },
      "when": { "north": true, "east": false, "south": true, "west": true, "up_east": false, "down_east": false }
    },
    { "apply": { "model": "powersim:block/copper_wire_t", "y": 90 },
      "when": { "north": true, "east": true, "south": true, "west": false, "up_west": false, "down_west": false }
    },

    { "apply": { "model": "powersim:block/copper_wire_cross" },
      "when": { "north": true, "east": true, "south": true, "west": true, "up_north": false, "down_north": false, "up_south": false, "down_south": false, "up_east": false, "down_east": false, "up_west": false, "down_west": false }
    },

    { "apply": { "model": "powersim:block/copper_wire_end", "y": 0 },
      "when": { "north": true, "east": false, "south": false, "west": false, "down_north": false, "up_north": false }
    },
    { "apply": { "model": "powersim:block/copper_wire_end", "y": 90 },
      "when": { "north": false, "east": true, "south": false, "west": false, "down_east": false, "up_east": false }
    },
    { "apply": { "model": "powersim:block/copper_wire_end", "y": 180 },
      "when": { "north": false, "east": false, "south": true, "west": false, "down_south": false, "up_south": false }
    },
    { "apply": { "model": "powersim:block/copper_wire_end", "y": 270 },
      "when": { "north": false, "east": false, "south": false, "west": true, "down_west": false, "up_west": false }
    }
  ]
}
